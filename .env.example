# ==============================================================================
# SismoWatch - Environment Variables Configuration Template
# All secret values must be externalized. Never commit real passwords to Git.
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=sismowatch_admin
POSTGRES_PASSWORD=SismoWatchSecretPassword2026!
POSTGRES_DB=sismowatch_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Read-Only Database Role (for AI Agent and Dashboard)
DB_READER_USER=app_curated_reader
DB_READER_PASSWORD=CuratedReaderPass123!

# Apache Airflow Configuration
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://sismowatch_admin:SismoWatchSecretPassword2026!@postgres:5432/sismowatch_db
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFfDewgnbL3hnhANo=
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__WEBSERVER__SECRET_KEY=sismowatch_airflow_super_secret_key_12345
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Seismic Data Source
SEISMIC_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
SEISMIC_API_LIMIT=20
SEISMIC_SLA_SECONDS=300

# Backend WebApp & Security
API_PORT=8000
JWT_SECRET=super_secret_jwt_key_sismowatch_prod_sec_2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Agent Configuration
AI_MODEL_NAME=local-seismic-agent
AI_TEMPERATURE=0.1
AI_GUARDRAIL_STRICT=true
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
