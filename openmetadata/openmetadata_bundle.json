          "dataType": "VARCHAR",
          "dataLength": 64,
          "description": "Original external seismic event ID",
          "constraint": "NOT_NULL"
        },
        {
          "name": "payload",
          "dataType": "JSON",
          "description": "Full unparsed JSON feature from USGS API",
          "constraint": "NOT_NULL"
        },
        {
          "name": "ingested_at",
          "dataType": "TIMESTAMP",
          "description": "Timestamp of raw extraction into lakehouse",
          "constraint": "NOT_NULL"
        },
        {
          "name": "run_id",
          "dataType": "VARCHAR",
          "dataLength": 64,
          "description": "Airflow DAG execution run identifier",
          "constraint": "NOT_NULL"
        }
      ],
      "tags": [
        "Tier.Tier1",
        "Layer.Bronze",
        "DataClassification.Public"
      ]
